<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: la pantalla de carga del sistema, con el icono de GPapers sobre el mismo fondo, enlaza sin saltos con la de arriba. -->
    <style name="Arranque" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/arranque</item>
        <item name="android:statusBarColor">@color/backgroundColor</item>
        <item name="android:navigationBarColor">@color/backgroundColor</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/backgroundColor</item>
    </style>
</resources>
